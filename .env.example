# 复制此文件为 .env 并填写你的配置
# cp .env.example .env

# ============================================================
# LLM 连接配置
# ============================================================

# OpenAI 兼容 API 的 Base URL
OPENAI_BASE_URL=https://api.openai.com/v1

# 你的 API Key
OPENAI_API_KEY=sk-your-api-key-here

# 模型名称
MODEL_NAME=gpt-4o-mini

# ============================================================
# 解析服务配置 (可选，均有合理默认值)
# 所有配置项以 PARSE_ 为前缀
# ============================================================

# pydantic-ai 输出校验重试次数 (默认 3)
# PARSE_OUTPUT_RETRIES=3

# HTTP 层 (429/5xx) 最大重试次数 (默认 5)
# PARSE_HTTP_MAX_RETRIES=5

# Agent 级最大并发运行数 (默认 10)
# PARSE_MAX_AGENT_CONCURRENCY=10

# Agent 级最大排队数 (默认 100)
# PARSE_MAX_AGENT_QUEUED=100

# Model HTTP 请求最大并发数 (默认 20)
# PARSE_MAX_MODEL_CONCURRENCY=20

# 服务级全局信号量上限 (默认 50)
# PARSE_SERVICE_SEMAPHORE_LIMIT=50

# 批量解析分片大小 (默认 20)
# PARSE_BATCH_CHUNK_SIZE=20

# 单次请求超时秒数 (默认 120)
# PARSE_REQUEST_TIMEOUT=120.0
